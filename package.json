{
  "name": "pro-swing-ai-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix frontend",
    "build:all": "npm run build && echo \"Frontend build complete\"",
    "backend:start": "python \"main_SKELETON_3D(2).py\"",
